PORT=3001
NODE_ENV=development

# Banco unificado (mesmo banco do frontend)
DB_HOST=localhost
DB_PORT=3306
DB_USER=marcon
DB_PASSWORD=changeme
DB_NAME=marcon

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Leitor RFID externo (opcional)
RFID_API_URL=
RFID_API_KEY=
RFID_TIMEOUT_MS=4000

# Origem do frontend (server-to-server não exige CORS, mas libera usos diretos)
CORS_ORIGIN=http://localhost:3000

# Apenas para npm run seed
SEED_PASSWORD=Marcon@12345
# Crachá RFID vinculado ao admin no seed (opcional)
ADMIN_RFID=AABBCCDDEE
