# db:migrate cria o banco se não existir (requer permissão CREATE).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marcon
DB_USER=root
DB_PASSWORD=root
# Alternativa: DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/marcon
# DB_NAME e DB_USER têm prioridade sobre DATABASE_URL.
SESSION_SECRET=segredo
# Também protege os embeddings faciais locais. Trocar o segredo exige recadastro facial.
# Defina apenas ao executar npm run db:seed; remova após o seed.
SEED_PASSWORD=Marcon@12345

# James: API da OpenAI no servidor. Nunca use NEXT_PUBLIC_ para a chave.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Voz local opcional no servidor (whisper.cpp e Piper, sem chave no navegador).
# Aponte para binários e modelos obtidos de suas distribuições oficiais.
JAMES_WHISPER_BIN=
JAMES_WHISPER_MODEL=
JAMES_PIPER_BIN=
JAMES_PIPER_MODEL=
JAMES_PIPER_CONFIG=

# Integração com a API do backend MARCON (Express). Obrigatória no modo MySQL:
# login, catálogo, estoque, requisições e dashboards passam a ser servidos por ela.
BACKEND_URL=http://localhost:3001

# Crachá RFID usado pelo botão de acesso simulado no modo persistente.
# No seed, a funcionária ana@marcon.demo recebe 0A1B2C3D4E e o admin recebe ADMIN_RFID.
RFID_DEMO_TAG=0A1B2C3D4E
