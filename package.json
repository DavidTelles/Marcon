{
  "name": "marcon",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-with-backend.mjs dev",
    "dev:next": "next dev",
    "build": "next build",
    "start": "node scripts/run-with-backend.mjs start",
    "start:next": "next start",
    "lint": "eslint",
    "sync:workspace": "node scripts/sync-workspace.mjs",
    "check:workspace": "node scripts/sync-workspace.mjs --check",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node scripts/db-seed.mjs",
    "setup": "node scripts/setup-env.mjs && npm ci && npm ci --prefix backend",
    "migrate": "npm run db:migrate",
    "seed": "node scripts/db-seed.mjs",
    "dev:api": "npm --prefix backend run dev",
    "test:api": "npm --prefix backend test",
    "format": "prettier --write app/login app/globals.css tests playwright.config.ts",
    "format:check": "prettier --check app/login app/globals.css tests playwright.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tesseract.js-data/por": "^1.0.0",
    "@zxing/browser": "^0.2.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
