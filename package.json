{
  "name": "marcon",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "catalog:sync": "node scripts/sync-parts-catalog.mjs",
    "check:hosting": "node scripts/check-hosting.mjs",
    "check:face": "node scripts/check-face-service.mjs",
    "test:face:node": "node scripts/face-node.test.mjs",
    "test:face:policy": "node --experimental-strip-types --test scripts/face-policy.test.mjs",
    "test:face:mobile": "node scripts/test-face-mobile.mjs",
    "test:face:http": "node scripts/test-face-http.mjs",
    "test:hosting": "node --test scripts/backend-config.test.mjs scripts/backend-client.test.mjs scripts/embedded-backend.test.mjs scripts/db-config.test.mjs scripts/database-health.test.mjs scripts/setup-env.test.mjs scripts/face-service.test.mjs",
    "marco:bridge": "node --env-file-if-exists=.env scripts/marco-bridge.mjs",
    "marco:doctor": "node scripts/marco-doctor.mjs",
    "marco:benchmark": "node scripts/benchmark-marco.mjs",
    "test:marco": "node --test tests/marco-*.test.mjs",
    "test:marco:integration": "node scripts/test-integrated-logistics.mjs --marco",
    "test:marco:regression": "playwright test --config playwright.marco.config.ts",
    "test:marco:cancel": "node scripts/test-marco-cancel.mjs",
    "dev": "node scripts/run-with-backend.mjs dev",
    "dev:next": "next dev",
    "build": "next build",
    "prebuild": "npm run check:workspace && npm run check:assets",
    "check:assets": "node scripts/check-product-assets.mjs",
    "test:pcp": "node scripts/test-pcp.mjs",
    "test:pcp:ui": "node scripts/test-pcp.mjs --ui",
    "test:pcp:embedded": "node scripts/test-pcp.mjs --ui --embedded",
    "test:qr": "node scripts/test-integrated-logistics.mjs --ui --qr --embedded",
    "test:qr:labels": "node --experimental-strip-types --test scripts/qr-labels.test.mjs",
    "test:request-origin": "node --experimental-strip-types --test scripts/request-origin.test.mjs",
    "start": "node scripts/run-with-backend.mjs start",
    "start:next": "next start",
    "lint": "eslint",
    "sync:workspace": "node scripts/sync-workspace.mjs",
    "check:workspace": "node scripts/sync-workspace.mjs --check",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node scripts/db-seed.mjs",
    "setup": "node scripts/setup-env.mjs && npm ci && npm ci --prefix backend",
    "migrate": "npm run db:migrate",
    "seed": "node scripts/db-seed.mjs",
    "dev:api": "npm --prefix backend run dev",
    "test:api": "npm --prefix backend test",
    "test:logistics": "node scripts/test-integrated-logistics.mjs",
    "test:logistics:ui": "node scripts/test-integrated-logistics.mjs --ui",
    "links:preview": "node scripts/link-existing-records.mjs",
    "test:login-routes": "node scripts/test-login-routes.mjs",
    "format": "prettier --write app/login app/globals.css tests playwright.config.ts",
    "format:check": "prettier --check app/login app/globals.css tests playwright.config.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "^16.3.6",
    "@tesseract.js-data/por": "^1.0.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "onnxruntime-node": "^1.30.0",
    "openai": "^7.23.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "ws": "^8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
