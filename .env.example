DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SESSION_SECRET=troque_um_segredo_aleatorio_com_pelo_menos_32_caracteres
# Também protege os vetores faciais no Neon. Trocar o segredo exige recadastro facial.
# Defina apenas ao executar npm run db:seed; remova após o seed.
SEED_PASSWORD=defina_uma_senha_forte_apenas_para_o_seed

# Marco: nunca use NEXT_PUBLIC_ para credenciais da ponte.
# Marco: backend only. Local development; never use localhost for the PC on Vercel.
MARCO_MODE=local
MARCO_OLLAMA_URL=http://127.0.0.1:11434
MARCO_OLLAMA_MODEL=qwen3.5:0.8b
MARCO_TIMEOUT_MS=45000
MARCO_CONTEXT_TOKENS=4096
MARCO_MAX_TOKENS=512
MARCO_KEEP_ALIVE_SECONDS=300
# On Vercel: MARCO_MODE=bridge, HTTPS URL of tunnel, same strong token as PC bridge.
MARCO_BRIDGE_TOKEN=
# PC bridge only: fixed upstream, loopback listener, bounded concurrency.
MARCO_LOCAL_OLLAMA_URL=http://127.0.0.1:11434
MARCO_BRIDGE_PORT=11435
MARCO_BRIDGE_CONCURRENCY=1

# Voz local opcional no servidor (whisper.cpp e Piper, sem chave no navegador).
# Aponte para binários e modelos obtidos de suas distribuições oficiais.
JAMES_WHISPER_BIN=
JAMES_WHISPER_MODEL=
JAMES_PIPER_BIN=
JAMES_PIPER_MODEL=
JAMES_PIPER_CONFIG=

# Executa os serviços do backend na mesma função Node.js do Next/Vercel.
# Para um Express separado, use sua URL base (sem /api ou /login).
# http://localhost:3001 só funciona quando o Express está rodando localmente.
BACKEND_URL=embedded
PORT=3001
JWT_SECRET=gere-um-segredo-aleatorio-longo-para-o-backend
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000


# Python virtual environment running the supplied YuNet/SFace models
FACE_PYTHON=

# Serviço facial hospedado (projeto Python com Root Directory = face).
# No Next/Vercel, use a URL HTTPS do serviço. Nunca use NEXT_PUBLIC_ nesses valores.
FACE_SERVICE_URL=
# Mesmo token aleatório (32+ caracteres) no Next e no serviço Python.
FACE_SERVICE_TOKEN=
# Opcional: bypass de Deployment Protection do projeto Python, somente no Next.
FACE_SERVICE_BYPASS_SECRET=
